# ==============================================================================
# POWER ALERT - Production Environment Configuration
# Tagline: Every Life Matters. Every Alert Counts.
# ==============================================================================

# MongoDB Connection String
# (Leave empty to use automatic embedded in-memory MongoDB during local testing)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/power_alert?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=power-alert-production-super-secret-key-change-in-production-2026

# Public App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend Transactional Email API Key
# (Leave as dummy to automatically run in instant simulated log preview mode)
RESEND_API_KEY=re_dummy_token
EMAIL_FROM=POWER ALERT <alerts@poweralert.org>

# Optional Cloudinary Storage (for production media uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
